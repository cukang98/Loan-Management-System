generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(cuid())
  userId           String         @unique
  email            String?        @unique
  password         String
  name             String
  isActive         Boolean        @default(true)
  actorType        String         @default("USER")
  userGroupId      String?
  userGroup        UserGroup?     @relation(fields: [userGroupId], references: [id])
  availableCapital Decimal?       @db.Decimal(15, 2)
  totalLent        Decimal?       @default(0) @db.Decimal(15, 2)
  loans            Loan[]
  refreshTokens    RefreshToken[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId])
  @@index([actorType])
}

model UserGroup {
  id           String       @id @default(cuid())
  name         String       @unique
  isSuperAdmin Boolean      @default(false)
  permissions  Permission[]
  users        User[]
  createdAt    DateTime     @default(now())
}

model Permission {
  id          String    @id @default(cuid())
  module      String
  action      String
  userGroupId String
  userGroup   UserGroup @relation(fields: [userGroupId], references: [id], onDelete: Cascade)

  @@unique([module, action, userGroupId])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Customer {
  id        String   @id @default(cuid())
  fullName  String
  phone     String
  email     String?
  address   String?
  notes     String?
  loans     Loan[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([fullName])
}

// ─────────────────────────────────────────────
// Loan core entity
// ─────────────────────────────────────────────
model Loan {
  id             String              @id @default(cuid())
  customerId     String
  customer       Customer            @relation(fields: [customerId], references: [id])
  lenderId       String
  lender         User                @relation(fields: [lenderId], references: [id])
  principal      Decimal             @db.Decimal(15, 2)
  interestRate   Decimal             @db.Decimal(8, 4) // flat rate as % of principal (or periodic % for REDUCING)
  interestAmount Decimal             @db.Decimal(15, 2) // total absolute interest over loan life
  tenure         Int
  tenureType     TenureType
  repaymentType  RepaymentType
  interestModel  InterestModel       @default(FLAT)
  startDate      DateTime            @db.Date
  status         LoanStatus          @default(ACTIVE)
  schedules      RepaymentSchedule[]
  repayments     Repayment[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([customerId])
  @@index([lenderId])
  @@index([status])
}

// ─────────────────────────────────────────────
// Generated repayment schedule (one row per installment)
// ─────────────────────────────────────────────
model RepaymentSchedule {
  id            String                @id @default(cuid())
  loanId        String
  loan          Loan                  @relation(fields: [loanId], references: [id])
  installmentNo Int
  dueDate       DateTime              @db.Date
  principalDue  Decimal               @db.Decimal(15, 2)
  interestDue   Decimal               @db.Decimal(15, 2)
  totalDue      Decimal               @db.Decimal(15, 2)
  paidAmount    Decimal               @default(0) @db.Decimal(15, 2)
  status        ScheduleStatus        @default(PENDING)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  allocations   RepaymentAllocation[]

  @@index([loanId])
  @@index([dueDate])
  @@index([status])
}

// ─────────────────────────────────────────────
// Payment event (cash received from borrower)
// ─────────────────────────────────────────────
model Repayment {
  id          String                @id @default(cuid())
  loanId      String
  loan        Loan                  @relation(fields: [loanId], references: [id])
  amount      Decimal               @db.Decimal(15, 2)
  paymentDate DateTime              @db.Date
  method      PaymentMethod         @default(CASH)
  notes       String?
  createdAt   DateTime              @default(now())
  allocations RepaymentAllocation[]

  @@index([loanId])
}

// ─────────────────────────────────────────────
// Maps each payment to one or more schedule rows
// ─────────────────────────────────────────────
model RepaymentAllocation {
  id            String            @id @default(cuid())
  repaymentId   String
  repayment     Repayment         @relation(fields: [repaymentId], references: [id])
  scheduleId    String
  schedule      RepaymentSchedule @relation(fields: [scheduleId], references: [id])
  amountApplied Decimal           @db.Decimal(15, 2)
  createdAt     DateTime          @default(now())

  @@index([repaymentId])
  @@index([scheduleId])
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────
enum LoanStatus {
  ACTIVE
  COMPLETED
  DEFAULTED
}

enum TenureType {
  DAY
  WEEK
  MONTH
}

enum RepaymentType {
  INSTALLMENT
  DAILY
  MONTHLY
  ROLLING
}

enum InterestModel {
  FLAT
  REDUCING
}

enum ScheduleStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  MOBILE_MONEY
  OTHER
}
